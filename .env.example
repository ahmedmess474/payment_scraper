PORT=3000

# Only read by docker-compose.yml, to run the container as your host user
# instead of guessing — needed so writes to the bind-mounted ./secrets and
# ./data directories actually work. Defaults to 1000:1000 if unset; check
# your real values with `id -u` / `id -g` on the host if they differ.
# APP_UID=1000
# APP_GID=1000

# Algerie Poste CCP portal
ALGERIE_POSTE_BASE_URL=https://eccp.poste.dz
ALGERIE_POSTE_LOGIN_URL=https://eccp.poste.dz/
ALGERIE_POSTE_RELEVE_URL=https://eccp.poste.dz/relev%C3%A9-de-compte
ALGERIE_POSTE_USERNAME=
ALGERIE_POSTE_PASSWORD=

# Run the browser visibly (false) while we figure out selectors, headless (true) once stable
PUPPETEER_HEADLESS=false

# Persistent browser profile so cookies/session/reCAPTCHA trust survive across runs
PUPPETEER_USER_DATA_DIR=./.puppeteer-profile

# The portal only accepts connections from Algerian IPs. Leave unset when
# running from inside Algeria; set this when deployed elsewhere, to route
# Chrome's traffic through a proxy/tunnel whose exit point is in Algeria.
# Accepts anything Chrome's --proxy-server flag does, e.g.:
#   PROXY_SERVER=http://1.2.3.4:8080
#   PROXY_SERVER=socks5://127.0.0.1:1080   (e.g. an SSH -D tunnel to an Algerian host)
# PROXY_USERNAME/PROXY_PASSWORD are only needed if that proxy requires auth.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Cost guard — Algerie Poste charges per relevé query
COST_PER_MONTH_DA=40
COST_PER_PAGE_DA=5
COST_CONFIRM_THRESHOLD_DA=200

# Bearer token required by POST /scrape (costs real money and returns real
# statement data per call) and POST /session-cookies (writes the login
# credential). Required — both endpoints refuse every request while this is
# unset. Generate one long random value, e.g.: openssl rand -hex 32
ADMIN_TOKEN=
