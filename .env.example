PORT=3000

# Algerie Poste CCP portal
ALGERIE_POSTE_BASE_URL=https://eccp.poste.dz
ALGERIE_POSTE_LOGIN_URL=https://eccp.poste.dz/
ALGERIE_POSTE_RELEVE_URL=https://eccp.poste.dz/relev%C3%A9-de-compte
ALGERIE_POSTE_USERNAME=
ALGERIE_POSTE_PASSWORD=

# Run the browser visibly (false) while we figure out selectors, headless (true) once stable
PUPPETEER_HEADLESS=false

# Persistent browser profile so cookies/session/reCAPTCHA trust survive across runs
PUPPETEER_USER_DATA_DIR=./.puppeteer-profile

# Cost guard — Algerie Poste charges per relevé query
COST_PER_MONTH_DA=40
COST_PER_PAGE_DA=5
COST_CONFIRM_THRESHOLD_DA=200

# Bearer token required by POST /session-cookies, which lets you push a
# refreshed session cookie export to the server instead of SSHing in to
# overwrite secrets/session-cookies.json by hand. Required — the endpoint
# refuses every request while this is unset. Generate one long random value,
# e.g.: openssl rand -hex 32
ADMIN_TOKEN=
